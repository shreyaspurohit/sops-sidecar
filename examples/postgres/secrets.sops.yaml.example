# Walkthrough: create the two inputs this example needs, age.key and
# secrets.sops.yaml. Run the commands from this directory. The plaintext below
# is a placeholder.
#
# 1. Generate an age identity. The private key stays on this machine.
#
#      export SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt   # sops's default on Linux, not on macOS
#      mkdir -p ~/.config/sops/age
#      [ -e "$SOPS_AGE_KEY_FILE" ] || age-keygen -pq -o "$SOPS_AGE_KEY_FILE"
#      cp "$SOPS_AGE_KEY_FILE" age.key
#      sudo chown 0:0 age.key && sudo chmod 0400 age.key
#
#    The public key (recipient) is printed and is also the "# public key:"
#    line inside the key file. The sidecar drops every capability, so even
#    root cannot read an age.key it does not own. age.key must be owned by the
#    sidecar's uid (0 here) with mode 0400. It is the deployment copy; sops
#    reads the workstation copy through SOPS_AGE_KEY_FILE. -pq makes a post-quantum
#    hybrid key (needs age 1.3+); classic keys work too.
#
# 2. Write the plaintext (contents below) to a temporary file, then encrypt:
#
#      sops encrypt --age <recipient> \
#        --input-type yaml --output-type yaml \
#        plaintext.yaml > secrets.sops.yaml
#      rm plaintext.yaml
#      chmod 0644 secrets.sops.yaml secrets.map.yaml   # no plaintext; the sidecar must read it
#
#    To change a secret later, edit it in place so the bind mount keeps
#    following the same file, then reload the sidecar. The README covers
#    adding a key and replacing the age key, under "Change, add or
#    remove a secret" and "Add or replace an age key":
#
#      sops edit secrets.sops.yaml
#      docker compose kill -s HUP secrets
#
# 3. Start the stack:
#
#      docker compose up -d
#
# Plaintext to encrypt (placeholder values, top-level scalar keys only):
postgres_password: change-me
# Keys not listed in secrets.map.yaml are ignored by the sidecar.
unused_example_key: change-me-too
