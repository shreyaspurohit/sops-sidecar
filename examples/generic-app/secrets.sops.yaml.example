# Walkthrough: create the two inputs this example needs, age.key and
# secrets.sops.yaml. Run the commands from this directory. Nothing here is a
# real secret; the plaintext below is a placeholder.
#
# 1. Generate an age identity (the private key stays on this machine only):
#
#      mkdir -p ~/.config/sops/age && age-keygen -o ~/.config/sops/age/keys.txt
#      cp ~/.config/sops/age/keys.txt age.key
#      sudo chown 65532:65532 age.key && sudo chmod 0400 age.key
#
#    The public key (recipient) is printed, and is also the "# public key:"
#    line inside the key file. The sidecar drops every capability, so even
#    root cannot read an age.key it does not own: age.key must be owned by the
#    sidecar's uid (65532 here) with mode 0400. It is the deployment copy; sops
#    reads your own copy in ~/.config/sops/age/keys.txt by default.
#
# 2. Write the plaintext to a temporary file (contents below), then encrypt:
#
#      sops encrypt --age <recipient> \
#        --input-type yaml --output-type yaml \
#        plaintext.yaml > secrets.sops.yaml
#      rm plaintext.yaml
#
#    To change a secret later, edit it in place so the bind mount keeps
#    following the same file, then reload the sidecar:
#
#      sops edit secrets.sops.yaml
#      docker compose kill -s HUP secrets
#
# 3. Start the stack:
#
#      docker compose up -d
#
# Plaintext to encrypt (placeholder value, top-level scalar keys only). With
# no map file, each key becomes a file named after it: /run/secrets/api_token.
api_token: change-me
